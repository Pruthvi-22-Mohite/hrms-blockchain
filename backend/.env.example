# Copy to .env (gitignored) and fill in. Never commit .env.

PORT=4000
RPC_URL=http://127.0.0.1:8545

# Printed by `npx hardhat run scripts/deploy.js` in contracts/ (these are the
# addresses you get from a fresh `npx hardhat node`)
USER_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
RECORD_REGISTRY_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512

# Hardhat account #0 -- a publicly known TEST key, only valid on the local Hardhat network
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Any long random string (signs login tokens, seeds demo wallets)
JWT_SECRET=change-me
# 32 random bytes as 64 hex chars:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Leave PINATA_JWT empty to store files in a local folder instead of IPFS
PINATA_JWT=
PINATA_GATEWAY=https://gateway.pinata.cloud
